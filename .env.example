# Local (docker compose). db.localtest.me always resolves to 127.0.0.1.
DATABASE_URL=postgres://postgres:postgres@db.localtest.me:5432/main

# Production (Neon): use the connection string from the Neon/Vercel dashboard, e.g.
# DATABASE_URL=postgres://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
